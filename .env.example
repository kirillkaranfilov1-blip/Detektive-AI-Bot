# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# OpenAI / Compatible API Configuration
# Ключ OpenAI или совместимого сервиса (OpenRouter, Groq, DeepSeek, Ollama)
OPENAI_API_KEY="your_openai_api_key_here"

# Базовый URL (опционально, по умолчанию https://api.openai.com/v1)
# Например для OpenRouter: https://openrouter.ai/api/v1
# Для Groq: https://api.groq.com/openai/v1
# Для локальной Ollama: http://localhost:11434/v1
OPENAI_BASE_URL="https://api.openai.com/v1"

# Модель для ИИ-подозреваемых и судьи вердиктов
OPENAI_MODEL="gpt-4o-mini"

# База данных (SQLite по умолчанию, без необходимости разворачивать сервер)
# Для PostgreSQL можно указать: postgresql://user:password@localhost:5432/detektive_ai
DATABASE_URL="file:./dev.db"

# Уровень логирования (info, debug, warn, error)
LOG_LEVEL="info"
